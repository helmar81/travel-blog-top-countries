  function speakCountryName(countryCode: string) {
    const countryName = countryNames[countryCode.toLowerCase()];
    if (countryName && 'speechSynthesis' in window) {
      const utterance = new SpeechSynthesisUtterance(countryName);
      window.speechSynthesis.speak(utterance);
    } else {
      console.warn('Speech synthesis not supported or country name not found.');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const allCountriesContainer = document.getElementById('all-countries');
    const visitedCountriesContainer = document.getElementById('visited-countries');


    if (!allCountriesContainer || !visitedCountriesContainer) {
      console.error('Country containers not found.');
      return;
    }

    const visitedCountElement = document.getElementById('visited-count');

    const updateVisitedCount = () => {
      if (visitedCountElement) {
        visitedCountElement.textContent = `Visited: ${visitedCountriesContainer.querySelectorAll('.flag-item').length}`;
      }
    };

    const visitedCountries = JSON.parse(localStorage.getItem('visitedCountries') || '[]');

    // Load visited countries from localStorage
    visitedCountries.forEach((filename) => {
      const flagElement = allCountriesContainer.querySelector(`.flag-item[data-filename="${filename}"]`);
      if (flagElement) {
        visitedCountriesContainer.appendChild(flagElement);
      }
    });

    updateVisitedCount(); // Initial count update after loading from storage


    // Add dragstart listener to all flags
    allCountriesContainer.querySelectorAll('.flag-item').forEach(flag => {
      flag.addEventListener('dragstart', (event) => {
        if (event.dataTransfer) {
          event.dataTransfer.setData('text/plain', (event.target as HTMLElement).dataset.filename || '');
        }
      });
    });

    // Add click event listeners to all flags for voiceover
 allCountriesContainer.querySelectorAll('.flag-item').forEach((flag: HTMLElement) => {
      flag.addEventListener('click', (event) => {
        const filename = (event.currentTarget as HTMLElement).dataset.filename;
        const countryCode = filename ? filename.split('.')[0].toUpperCase() : '';
        speakCountryName(countryCode);
      });
    });

    // Add dragstart listener to flags in visited container as well, so they can be dragged back if needed
    // (This is a basic implementation; you might want a separate drop zone to move them back)
    // This part is commented out as it's not part of the core request but is a logical next step.
    /*

     visitedCountriesContainer.querySelectorAll('img').forEach(flag => {
      flag.addEventListener('dragstart', (event) => {
        if (event.dataTransfer) {
          event.dataTransfer.setData('text/plain', (event.target as HTMLElement).dataset.filename || '');
        }
      });
    });
    */

    // Add dragover listener to the visited countries container
    visitedCountriesContainer.addEventListener('dragover', (event) => {
      event.preventDefault(); // Necessary to allow dropping
    });

    // Add drop listener to the visited countries container
    visitedCountriesContainer.addEventListener('drop', (event) => {
      event.preventDefault();
      const filename = event.dataTransfer?.getData('text/plain');
      if (filename) {
        const draggedElement = allCountriesContainer.querySelector(`.flag-item[data-filename="${filename}"]`);
        if (draggedElement) {
          visitedCountriesContainer.appendChild(draggedElement);
          // Save the updated list to localStorage
          const currentVisited = Array.from(visitedCountriesContainer.querySelectorAll('img')).map(img => (img as HTMLElement).dataset.filename);
          localStorage.setItem('visitedCountries', JSON.stringify(currentVisited));
          updateVisitedCount(); // Update count after drop
        }
      }
    });

    // Add click event listeners to flags in visited container for voiceover
 visitedCountriesContainer.querySelectorAll('.flag-item').forEach((flag: HTMLElement) => {
      flag.addEventListener('click', (event) => {
        const filename = (event.currentTarget as HTMLElement).dataset.filename;
        const countryCode = filename ? filename.split('.')[0].toUpperCase() : '';
        speakCountryName(countryCode);
      });
    });


    const resetButton = document.getElementById('reset-button');
    if (resetButton) {
      resetButton.addEventListener('click', () => {
        localStorage.removeItem('visitedCountries');
        // Move all flags back to the all-countries section
        const visitedFlags = visitedCountriesContainer.querySelectorAll('.flag-item');
        visitedFlags.forEach(flag => {
          allCountriesContainer.appendChild(flag);
        });
        updateVisitedCount(); // Reset count to 0
      });
    } else {
      console.error('Reset button not found.');
    }
  });
</script>