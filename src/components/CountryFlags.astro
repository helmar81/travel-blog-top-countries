---
import { promises as fs } from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const flagsDirectory = path.join(__dirname, '../assets/flags');
let flagFiles: string[] = [];

try {
  flagFiles = await fs.readdir(flagsDirectory);
} catch (error) {
  console.error('Error reading flags directory:', error);
}

const countryFlags = flagFiles
  .filter(file => file.endsWith('.png'))
  .map(file => `/src/assets/flags/${file}`);
const __base = import.meta.env.BASE_URL;
---

<div>
  <div class="container">
    <div class="section">
      <h2>All Countries</h2>
      <div id="all-countries" class="flags-container">
        <!-- All flags will be loaded here by the script -->
 {countryFlags.map(flagSrc => {
 const filename = flagSrc.split('/').pop();
 const countryCode = filename ? filename.split('.')[0].toUpperCase() : '';
 return (
 <div class="flag-item" draggable="true" data-filename={filename}>
 <img src={flagSrc} alt={`${countryCode} Flag`} width="50" height="30" />
 <span>{countryCode}</span>
 </div>
 );
 })}
      </div>
    </div>
    <div class="section">
      <h2>Visited Countries</h2>
      <div id="visited-countries" class="flags-container drop-zone">
 <p id="visited-count">Visited: 0</p>
        <!-- Dropped flags will appear here -->
      </div>
    </div>
  </div>
  <button id="reset-button">Reset Visited Countries</button>
</div>

<style>
  .container {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding: 20px;
  }

  @media (min-width: 768px) {
    .container {
      grid-template-columns: 1fr 1fr;
    }
  }

  .section {
    border: 1px solid #eee;
    padding: 15px;
    border-radius: 8px;
  }

  .flags-container.all-countries {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    padding: 20px;
  }

  .flag-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
 cursor: grab;
  }

 .flags-container.drop-zone {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
 cursor: grab;
  }


  .drop-zone {
    min-height: 100px; /* Give the drop zone some visual space */
    background-color: #f9f9f9;
  }

  .flags-container img {
    border: 1px solid #ccc;
    box-shadow: 1px 1px 3px rgba(0,0,0,0.1);
  }
</style>

<style>
 #reset-button {
    margin-top: 20px;
 }
</style>

